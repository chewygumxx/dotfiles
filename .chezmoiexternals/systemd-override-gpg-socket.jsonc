    },
    "dot_local/bin/systemd-override-gpg-socket": {
        "type": "file",
        "executable": true,
        "refreshPeriod": "168h",
        "url": "https://raw.githubusercontent.com/chewygumxx/systemd-override-gpg-socket/refs/heads/main/systemd-override-gpg-socket"
    }
