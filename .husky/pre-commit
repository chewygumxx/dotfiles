#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/dotfiles.git
# ::: :/.husky/pre-commit
#
#

set -e

if ! command -v luafmt >/dev/null 2>&1 || ! command -v luacheck >/dev/null 2>&1; then
    echo "pre-commit: luafmt/luacheck not on PATH, skipping Lua checks" >&2
    exit 0
fi

lua_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.lua')
[ -z "$lua_files" ] && exit 0

# Format in place, then re-stage whatever changed.
echo "$lua_files" | xargs luafmt --write
echo "$lua_files" | xargs git add --

# luacheck resolves .luacheckrc relative to --config's directory rather
# than walking up from each checked file, so find the nearest ancestor
# .luacheckrc per file instead of assuming one shared config.
status=0
for f in $lua_files; do
    dir=$(dirname "$f")
    while [ "$dir" != "." ] && [ ! -f "$dir/.luacheckrc" ]; do
        dir=$(dirname "$dir")
    done
    if [ -f "$dir/.luacheckrc" ]; then
        luacheck --config "$dir/.luacheckrc" "$f" || status=1
    else
        luacheck "$f" || status=1
    fi
done

exit $status
