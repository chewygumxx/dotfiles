#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/dotfiles.git
# ::: :/.husky/pre-commit
#
#

set -e

status=0

# --------
# Whitespace
# --------

# Only the lines this commit adds: trailing whitespace, a blank line at end of
# file, and leftover conflict markers, as .editorconfig asks. Older files still
# have some, so the whole tree is not checked.
git diff --cached --check || status=1

# --------
# Lua
# --------

if command -v luafmt >/dev/null 2>&1 && command -v luacheck >/dev/null 2>&1; then
    # chezmoi's symlink_*.lua "source" files hold a plain target path, not
    # Lua, despite the extension, so exclude them.
    lua_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.lua' ':!**/symlink_*')
    if [ -n "$lua_files" ]; then
        # Format in place, then re-stage whatever changed.
        echo "$lua_files" | xargs luafmt --write
        echo "$lua_files" | xargs git add --

        # luacheck resolves .luacheckrc relative to --config's directory
        # rather than walking up from each checked file, so find the
        # nearest ancestor .luacheckrc per file instead of assuming one
        # shared config.
        for f in $lua_files; do
            dir=$(dirname "$f")
            while [ "$dir" != "." ] && [ ! -f "$dir/.luacheckrc" ]; do
                dir=$(dirname "$dir")
            done
            if [ -f "$dir/.luacheckrc" ]; then
                luacheck --config "$dir/.luacheckrc" "$f" || status=1
            else
                luacheck "$f" || status=1
            fi
        done
    fi
else
    echo "pre-commit: luafmt/luacheck not on PATH, skipping Lua checks" >&2
fi

# --------
# TOML
# --------

if command -v tombi >/dev/null 2>&1; then
    toml_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.toml' ':!**/symlink_*')
    if [ -n "$toml_files" ]; then
        # tombi honours .tombi.toml's [files].exclude even for files passed
        # explicitly, and only one root config exists, so no per-directory
        # resolution is needed here unlike the Lua tools above.
        echo "$toml_files" | xargs tombi format --offline
        echo "$toml_files" | xargs git add --
        echo "$toml_files" | xargs tombi lint --error-on-warnings --offline || status=1
    fi
else
    echo "pre-commit: tombi not on PATH, skipping TOML checks" >&2
fi

# --------
# JSON/YAML
# --------

if command -v bunx >/dev/null 2>&1; then
    # chezmoi's symlink_*.{json,yaml} "source" files hold a plain target
    # path, not real content, so exclude them. Also exclude actual symlinks
    # (e.g. .luarc.json -> dot_luarc.json): Prettier refuses to check a
    # symlink passed explicitly, and the target is already covered by this
    # same glob.
    json_yaml_files=$(
        git diff --cached --name-only --diff-filter=ACMR \
            -- '*.json' '*.jsonc' '*.yaml' '*.yml' ':!**/symlink_*' |
            while IFS= read -r f; do [ -L "$f" ] || printf '%s\n' "$f"; done
    )
    if [ -n "$json_yaml_files" ]; then
        echo "$json_yaml_files" | xargs bunx --bun --no-install prettier --write
        echo "$json_yaml_files" | xargs git add --
    fi
else
    echo "pre-commit: bunx not on PATH, skipping JSON/YAML checks" >&2
fi

# --------
# Zsh
# --------

# Every file in the zsh tree is zsh source, most without an extension, apart
# from chezmoi's own .chezmoiignore, shuck's .shuck.toml and any symlink_*
# "source" file. Neither tool rewrites anything, so nothing is re-staged.
# Both read the working tree, so skip a staged file that is gone from it
# (e.g. a rename staged ahead of a deletion).
zsh_files=$(
    git diff --cached --name-only --diff-filter=ACMR -- 'home/dot_config/zsh/' \
        ':!**/symlink_*' ':!**/.chezmoiignore' ':!**/.shuck.toml' |
        while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done
)

if command -v zsh >/dev/null 2>&1; then
    # Parse only: a syntax error in env/ or .zshenv breaks every zsh start,
    # scp, rsync and git over ssh included.
    for f in $zsh_files; do
        zsh -n -- "$f" || status=1
    done
else
    echo "pre-commit: zsh not on PATH, skipping zsh syntax checks" >&2
fi

if command -v shuck >/dev/null 2>&1; then
    # shuck finds home/dot_config/zsh/.shuck.toml by walking up from each
    # file, and needs it: it maps the extensionless files to zsh, which they
    # would otherwise be misread as sh.
    if [ -n "$zsh_files" ]; then
        echo "$zsh_files" | xargs shuck check || status=1
    fi
else
    echo "pre-commit: shuck not on PATH, skipping zsh lint" >&2
fi

exit $status
