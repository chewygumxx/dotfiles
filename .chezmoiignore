# vim: filetype=gitignore

# 
# 
# ~/.local/share/chezmoi/.chezmoiignore
# 
# 

# Ignore everything not explicitly excepted
*


# -------------------
# Excepted Everywhere
# -------------------

# Contain .chezmoiignore within
!/.config/
!/.local/

# Does not contain .chezmoiignore within
!/.ssh/
/.ssh/*
!/.ssh/id/
/.ssh/id/*
!/.ssh/config  # Template


# ------------------
# Chewytop Exclusive
# ------------------

{{- if eq .chezmoi.hostname "chewytop" }}

# Contain .chezmoiignore within
!/net/
!/ref/

# Does not contain .chezmoiignore within
!/app/
/app/*

!/arc/
/arc/*

!/dev/
/dev/*

!/doc/
/doc/*
!/doc/tealdeer/

!/scr/
/scr/*

# Explicitly always ignore
/sec/

{{- end }}


# -------------------
# Chewytele Exclusive
# -------------------

{{- if eq .chezmoi.destDir "/data/data/com.termux/files/home" }}

!/.termux       # Symlink ~/.termux ->    .config/termux/
!/.shortcuts    # Symlink ~/.shortcuts -> .termux/shortcuts/

!/_chewygumxx   # Symlink to Symlink   ./.local/sym/_chewygumxx 
                # (which then symlinks directory /share/emulated/0/_chewygumxx/)

!/app           # Symlink to Directory ./_chewygumxx/app/
!/bin           # Symlink to Directory ./.local/bin/
!/dev           # Symlink to Directory ./_chewygumxx/dev
!/doc           # Symlink to Directory ./_chewygumxx/doc
!/nb            # Symlink to Directory ./doc/synaptic-nexus
!/net           # Symlink to Directory ./_chewygumxx/net
!/ref           # Symlink to Directory ./_chewygumxx/ref
!/scr           # Symlink to Directory ./_chewygumxx/scr

!/downloads/
/downloads/*

{{- end }}
