# vim: filetype=gitignore

# 
# 
# ~/.local/share/chezmoi/.chezmoiignore
# 
# 

# Ignore everything not explicitly excepted
*


# -------------------
# Excepted Everywhere
# -------------------

!.bash_history  # For ~czroot/remove_dot_bash_history
!gen_wezterm_terminfo
!xattar.sh

# Contain .chezmoiignore within
!.config/
!.local/

# Does not contain .chezmoiignore within
.ssh/**
!.ssh/
!.ssh/config
.ssh/id/**
!.ssh/id/


# Contain .chezmoiignore within
!net/
!ref/

# Does not contain .chezmoiignore within
app/**
!app/

arc/**
!arc/

dev/**
!dev/
dev/_gist/**
!dev/_gist/

doc/**
!doc/
!doc/tealdeer/

scr/**
!scr/

# ------------------
# Chewytop Exclusive
# ------------------

{{- if eq .chezmoi.hostname "chewytop" }}

# Explicitly always ignore
sec/

{{- end }}


# -------------------
# Chewytele Exclusive
# -------------------

{{- if eq .chezmoi.destDir "/data/data/com.termux/files/home" }}

!.termux       # Symlink ~/.termux ->    .config/termux/
!.shortcuts    # Symlink ~/.shortcuts -> .termux/shortcuts/

!_chewygumxx   # Symlink to Symlink   ./.local/sym/_chewygumxx 
                # (which then symlinks directory /share/emulated/0/_chewygumxx/)

downloads/**
!downloads/

{{- end }}
