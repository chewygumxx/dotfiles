{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "dotfiles",
    "version": "1.0.0",
    "private": true,
    "description": "My chezmoi-managed dotfiles",
    "keywords": [
        "dotfiles",
        "config",
        "chezmoi"
    ],
    "homepage": "https://github.com/chewygumxx/dotfiles",
    "repository": "github:chewygumxx/dotfiles",
    "engines": {
        "bun": ">=1.4"
    },
    "devDependencies": {
        "@chewygumxx/biome-config": "^1.1.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/markdownlint-cli2-config": "^1.1.0",
        "@chewygumxx/yamllint-config": "^1.0.1",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.7",
        "remark-frontmatter": "^5.0.0",
        "remark-preset-lint-consistent": "^6.0.1",
        "remark-preset-lint-recommended": "^7.0.1",
        "skills": "^1.7.5",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "commit": "cz",
        "prepare": "husky",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "settings": {
            "bullet": "-"
        },
        "plugins": [
            "remark-frontmatter",
            "remark-preset-lint-recommended",
            "remark-preset-lint-consistent"
        ]
    }
}
