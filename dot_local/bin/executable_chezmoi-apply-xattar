#!/bin/sh
# vim: expandtab:shiftwidth=4

# 
# 
# ~chewygumxx/chezmoi-apply-xattar.git:/chezmoi-apply-xattar
# 
# 

#
# Tags every chezmoi sensitive file with an xattr, if the
# platform and destination filesystem support it. Logs skips and
# failures to a dedicated log.
#
# Fails on paths containing newline characters.
#

set -u

XATTR_NAME="chezmoi"

__this_file="${0##*/}"
log_dir="${XDG_STATE_HOME:-${HOME}/.local/state}"
log_file="${log_dir}/${__this_file}.log"

VERBOSE=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=1; shift;;
        --)           shift;     break;;
        -*) 
            printf '%s: unknown option: %s\n' "${__this_file}" "$1" >&2
            exit 2
            ;;
        *) break ;;
    esac
done

log() {
    level="$1"; shift

	timestamp=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
	printf '%s [%s] %s\n' "$timestamp" "$level" "$*" >> "$log_file" 2>/dev/null || true

	case "$level" in
	    NOTICE|WARN|ERROR|FATAL)
            printf '%s: [%s] %s\n' "${__this_file}" "$level" "$*" >&2 ;;
	    *) [ "$VERBOSE" -eq 1 ] && \
            printf '%s: [%s] %s\n' "${__this_file}" "$level" "$*" >&2 ;;
    esac
}

if ! mkdir_stdouterr="$(mkdir -p "$log_dir" 2>&1)"; then
    log WARN "Failed to create log file directory"
    log WARN "$mkdir_stdouterr"
fi

# ---------------------
# Validate Environment
# ---------------------

if ! command -v chezmoi >/dev/null 2>&1; then
	log FATAL "Command not found: chezmoi"
	exit 127
fi

chezmoi_dest_dir="$(chezmoi target-path)"

if command -v setfattr >/dev/null 2>&1; then
	set_xattr() {
        user_xattr_name="$1"
        user_xattr_value="$2"
        file="$3"
		setfattr -n "user.$user_xattr_name" -v "$user_xattr_value" -- "$file"
	}
elif command -v xattr >/dev/null 2>&1; then
	set_xattr() {
        user_xattr_name="$1"
        user_xattr_value="$2"
        file="$3"
		xattr -w "$user_xattr_name" "$user_xattr_value" "$file"
	}
else
	log FATAL "Neither 'setfattr' nor 'xattr' found"
	exit 127
fi

if probe_file=$(mktemp "$chezmoi_dest_dir/.chezmoi_xattr_probe.XXXXXX" 2>&1); then
    :
else
    mktemp_exit=$?
    log FATAL "Could not create probe file: ${probe_file}"
	log FATAL "$probe_file"
    exit $mktemp_exit
fi

if set_xattr_stdouterr="$(set_xattr "$XATTR_NAME" "probe" "$probe_file" 2>&1)"; then
    :
else
    set_xattr_exit=$?
	log FATAL "Destination filesystem at ${chezmoi_dest_dir} appears not to support xattrs"
	log FATAL "$set_xattr_stdouterr"
	rm -f "$probe_file"
	exit $set_xattr_exit
fi
rm -f "$probe_file"

log INFO 'xattr write support confirmed'


# -------------
# Apply xattar
# -------------

tag() {
    if [ "$1" = "managed" ] || [ "$1" = "unmanaged" ]; then
        paths="$(chezmoi "$1" --path-style=absolute --exclude=symlinks,remove,scripts)"
    elif [ "$1" = "ignored" ]; then
        paths="$(chezmoi "$1" -0 | xargs -0 printf "$chezmoi_dest_dir/%s\n")"
    else
        log FATAL "(tag) Tag provided not 'ignored', 'managed' or 'unmanaged': $1"
        exit 1
    fi

    if run_log=$(mktemp 2>&1); then
        :
    else
        mktemp_exit=$?
        log FATAL "Failed to create run log"
        log FATAL "${run_log}"
        exit $mktemp_exit
    fi

    printf "%s" "$paths" | while IFS= read -r file; do
        # Validate either regular file or directory
        [ ! -f "$file" ] && [ ! -d "$file" ] && continue
        [ ! -L "$file" ] || continue
        
        if set_xattr_stdouterr="$(set_xattr "$XATTR_NAME" "$1" "$file" 2>&1)"; then
            echo OK    >> "$run_log" 2>/dev/null
            log  INFO  "Tag $1 success: ${file}"
        else
            echo FAIL  >> "$run_log" 2>/dev/null
            log  ERROR "Tag $1 FAILURE: ${file}"
            log  ERROR "$set_xattr_stdouterr"
        fi
    done

    tagged=$(grep -c '^OK$'   "$run_log" 2>/dev/null)
    failed=$(grep -c '^FAIL$' "$run_log" 2>/dev/null)
    log NOTICE "Tagging $1 complete: ${tagged} tagged, ${failed} failed"
    rm -f "$run_log" 2>/dev/null
}

tag managed
tag unmanaged
tag ignored

if [ -r "$log_file" ]; then
    log NOTICE "See log file at: ${log_file}"
fi
