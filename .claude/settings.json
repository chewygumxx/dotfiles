{
    "$schema": "https://www.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-chezmoi-apply.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh",
                        "statusMessage": "Linting edited file",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
