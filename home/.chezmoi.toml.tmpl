#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/.chezmoi.toml.tmpl
#
#

#
# Chezmoi Tracked Self-Configuration
#
# This file updates local chezmoi config file upon `chezmoi init` or valid
# `chezmoi <subcommand> --init` eg. `chezmoi update --init`.
#


progress        = true  # Display progress bars
encryption      = "gpg"

# Chezmoi Intrinsic  Paths
sourceDir       = {{ joinPath
    .chezmoi.homeDir
    "dev"
    "dotfiles"
| quote }}
cacheDir        = {{ joinPath
    (or (env "XDG_CACHE_HOME") (joinPath .chezmoi.homeDir ".cache"))
    "chezmoi"
| quote }}
persistentState = {{ joinPath
    (or (env "XDG_STATE_HOME") (joinPath .chezmoi.homeDir ".local" "state"))
    "chezmoi"
    "chezmoistate.boltdb"
| quote }}

# Handling of filesystem permissions in Termux and Android Emulated Storage
{{- if (eq .chezmoi.os "android") }}
umask = 0o22
{{ end }}

[edit]
apply    = true
watch    = true
hardlink = false # Do not hardlink to a tmpdir, disrupts filetype resolution
                 # by path

[gitHub]
# Same period as externals, from the data file that defines their defaults
refreshPeriod = {{ (include ".chezmoidata/externals.toml" | fromToml).externals.refreshPeriod | quote }}

[diff]
pager = {{ or
    (lookPath "delta")
    (lookPath "diffnav")
    (lookPath "less")
| quote }}
{{- $gitDiff := joinPath .chezmoi.homeDir ".local" "bin" "chezmoi-git-diff" }}
{{- if and (lookPath "git") (stat $gitDiff) }}
# Route through git so git attribute diff drivers apply (eg. semantic JSON);
# only once applied, so a fresh `chezmoi init` keeps the builtin diff
command = {{ $gitDiff | quote }}
args    = ["{{ "{{ .Destination }}" }}", "{{ "{{ .Target }}" }}"]
{{- end }}
