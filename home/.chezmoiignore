# -------------------
# Ignored Everywhere
# -------------------

.claude/
.claude.json
sec/


# ------------------
# Chewytop Ignored
# ------------------

{{- if eq .chezmoi.hostname "chewytop" }}

.termux       # Symlink ~/.termux ->    .config/termux/
.shortcuts    # Symlink ~/.shortcuts -> .termux/shortcuts/

_chewygumxx   # Symlink to Symlink   ./.local/sym/_chewygumxx
              # (which then symlinks directory /share/emulated/0/_chewygumxx/)

downloads/

{{- end }}


# -------------------
# Chewytele Ignored
# -------------------

{{- if eq .chezmoi.destDir "/data/data/com.termux/files/home" }}

.chezmoiscripts/wezterm-terminfo   # WezTerm doesn't run on Termux; also sidesteps a known
                                   # chezmoi/Termux fork/exec quirk when staging run_ scripts.

.chezmoiscripts/migrate-chromium-profile         # Neither browser runs on Termux
.config/systemd/user/ungoogled-chromium.service
.local/bin/chromium
.local/bin/crx-unpack
.local/share/chromium/
.local/share/mozilla/

{{- end }}
