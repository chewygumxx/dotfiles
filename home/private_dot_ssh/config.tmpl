#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/private_dot_ssh/config.tmpl
#
#

#
# Templated with chezmoi
#

# SSH_AUTH_SOCK from the environment variable registry,
# home/.chezmoidata/environment.toml, left for ssh to expand: zsh and systemd
# export every variable it references.
IdentityAgent {{ (includeTemplate "environment/resolve" . | fromJson).byName.SSH_AUTH_SOCK | quote }}
{{- if eq .chezmoi.os "android" }}
AddKeysToAgent yes
{{- end }}

Host *.github.com github.com
    User           git
{{- if eq .chezmoi.os "android" }}
    IdentitiesOnly yes
    IdentityFile   ~/.ssh/id/chewytele-github
{{- end }}

{{ if eq .chezmoi.os "linux" }}
Host chewytele
    Hostname       192.168.4.22
    Port           8022
{{ else if eq .chezmoi.os "android" }}
Host chewytop
    Hostname       192.168.4.21
    Port           22
    IdentityFile   ~/.ssh/id/chewytele-top
    IdentitiesOnly yes
{{- end }}
