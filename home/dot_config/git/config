# ::: :/home/dot_config/git/config
#
#

[init]
	defaultBranch = main

[user]
	name  = chewygumxx
	email = cgumxx@pm.me



[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	dark         = true
	navigate     = true
	side-by-side = true
	line-number  = true


# -------
# Remote
# -------

[remote]
    # No more `git push --set-upstream=origin`
    pushDefault = origin

[push]
    # Push the current branch to the corresponding on remote
    default = simple

[pull]
	rebase = false

[merge]
	conflictStyle = zdiff3



# --------
# Aliases
# --------

[alias]
    root  = rev-parse --show-toplevel
    cdr   = '!cd "$(git rev-parse --show-toplevel)"'

    s     = status
    cm    = commit -m
    sdiff = diff --staged
    srest = restore --staged --

    l    = log --date=format-local:'%a %d %b %H:%M' -1
    ll   = log --date=format-local:'%a %d %b %H:%M'
    lll  = log --date=format-local:'%a %d %b %H:%M' --pretty=logline -10
    llll = log --date=format-local:'%a %d %b %H:%M' --pretty=logline

    fpush = push --force


# ---------------
# User Interface
# ---------------

[pretty]
    logline = %C(blue)[%C(magenta)%cd%C(blue)] %C(green)%h %C(reset)%s %C(blue)%d

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
