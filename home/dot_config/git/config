[init]
	defaultBranch = main

[user]
	name  = chewygumxx
	email = cgumxx@pm.me

[safe]
	directory = /storage/emulated/0/_chewygumxx/doc/synaptic-nexus

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	dark         = true
	navigate     = true
	side-by-side = true
	line-number  = true

[merge]
	conflictStyle = zdiff3

[pull]
	rebase = false
