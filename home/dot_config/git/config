#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_config/git/config
#
#

[init]
	defaultBranch = main

[user]
	name  = chewygumxx
	email = cgumxx@pm.me

# --------
# Utility
# --------

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	dark         = true
	navigate     = true
	side-by-side = true
	line-number  = true

# Diff JSON by content rather than formatting: sorted keys, uniform indent
# (selected per file via ./attributes; `--no-textconv` shows raw bytes)
[diff "json"]
	textconv = json-normalize

# -------
# Remote
# -------

[remote]
    # No more `git push --set-upstream=origin`
    pushDefault = origin

[push]
    # Push the current branch to the corresponding on remote
    default = simple
	autoSetupRemote = true

[pull]
	rebase = false

[merge]
	conflictStyle = zdiff3

# --------
# Aliases
# --------

[alias]
    # Working Tree
    s     = status
    cm    = commit -m
    sdiff = diff --staged
    srest = restore --staged --

    # Commit History/Log
    # '%a %d %b %H:%M' -> Mon 05 Oct 21:44
    l    = log --date=format-local:'%a %d %b %H:%M' -1
    ll   = log --date=format-local:'%a %d %b %H:%M'
    lll  = log --date=format-local:'%a %d %b %H:%M' --pretty=logline -10
    llll = log --date=format-local:'%a %d %b %H:%M' --pretty=logline

    # Circumvent Safety
    fpush = push --force
    ftag  = tag  --force
    fcm   = commit --no-verify -m

    # Repository Root
    root  = rev-parse --show-toplevel
    cdr   = '!cd "$(git rev-parse --show-toplevel)"' # FIX(@chewygumxx): There is an obvious solution I am not seeing

# -------
# Output
# -------

[pretty]
    logline = %C(blue)[%C(magenta)%cd%C(blue)] %C(green)%h %C(reset)%s %C(blue)%d

# --------
# git-lfs
# --------

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
