#MISE description="Query the mise registry with a shortname for a GitHub repo slug"
#MISE tools.jq="1.8"

#USAGE arg "<short>" help="Registry short name"
#USAGE complete "short" run="mise registry --complete"

set -euo pipefail

mise registry --json "${usage_short:?}" |
    jq -er '
        .backends[] |
        capture("^(aqua|github|packslip):(?<slug>[a-z/]+)") |
        .slug
    '
