#

# ${PATH:+...} avoids a leading empty entry (the current directory) when the
# manager starts without PATH. Bun's global bin is BUN_INSTALL_BIN in
# zsh/env/tools.env.zsh; zsh/env/base.env.zsh adds the same directories.
PATH="${PATH:+$PATH:}{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/.local/share/bun/bin"
PAGER="less -R"
EDITOR="nvim"
# environment.d does not nest quotes: "${EDITOR:-"nvim"}" gave VISUAL=nvim"
VISUAL="${EDITOR:-nvim}"
BROWSER=firefox
TERMCMD=wezterm
