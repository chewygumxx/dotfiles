[ui.toast]
# Popup Delivery
# - 'herdr'    Herdr drawn within host
# - 'terminal' Desktop notify via host terminal request
# - 'system'   Direct message via host operating system
# - 'off'      Disable entirely
delivery = "herdr"

# Delay: Event -> Notify
# Minimum time to validate change of agent status
delay_seconds = 2

# Draw: Herdr Popup
herdr = { position = "top-right" }

# Draw: Copied-to-Clipboard
clipboard = { position = "top-right", enabled = true }
