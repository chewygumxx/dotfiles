# Panel: Entity Profile
# [Builtin: agents]
#           - state_icon
#           - state_text
#           - machine
#           - workspace
#           - tab
#           - pane
#           - agent
#           - terminal_title
#           - terminal_title_stripped
#
# [Builtin: spaces]
#           - state_icon
#           - state_text
#           - workspace
#           - branch
#           - git_status
#
# [Custom]  Values reported via pane
#           metadata as: $<token-name>
#
# [Styling] { token = "workspace", fg = "#89b4fa", bold = true, dim = false }.
#
# https://herdr.dev/tui/docs/config-reference/#:~:text=ui%2Esidebar%2Eagents%2Erow%5Fgap
[ui.sidebar.spaces]
row_gap = 1
rows    = [ [ "state_icon", "workspace" ], [ "branch", "git_status" ] ]

[ui.sidebar.agents]
row_gap = 1
rows    = [ [ "state_icon", { token = "agent", bold = true, dim = false } ], [ { token = "workspace", bold = false, dim = false }, "tab" ], [ { token = "terminal_title_stripped", dim = true } ] ]
