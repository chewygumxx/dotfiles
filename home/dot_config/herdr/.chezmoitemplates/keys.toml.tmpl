#
# Fragment intended for insertion within chezmoi-populated herdr
# config.toml.tmpl masterdoc.
#
# https://herdr.dev/tui/docs/keyboard/
# https://herdr.dev/tui/docs/configuration/#keybindings
# https://herdr.dev/tui/docs/config-reference/
#

[keys]
# --------------
# Keymap Syntax
# --------------
#
# | System | Modifier | Punctuation |
# | ------ | -------- | ----------- |
# | esc    | ctrl     | plus        |
# | tab    | alt      | minus       |
# | up     | shift    | comma       |
# | down   | super    | backtick    |
# | enter  | cmd      | ampersand   |
# | left   | meta     | semicolon   |
# | right  | hyper    | apostrophe  |
#
# ** Modal Invocation **
#
# - Benefits
#   - Scoped capture trigger efficaciously addresses map pollution and
#     collision.
#   - Facilitates personalisation and accessibility for esoteric interface
#     (ie. one-handed while eating), and bespoke/idiomatic assignment.
#
# - Hindrance
#   - Necessitates preparatory key capture trigger, id est prefix.
#   - Intrinsically slower and of greater friction.
#   - The same as the last two items, now thrice.
#
# ** Activation Reliability **
#
# - Dependable:
#   - "ctrl+<letter>"
#   - Function keys
#
# - Environment Dependant:
#   - "alt+..."
#   - "cmd/super"
#
# - Logged Failure
#   - Modifier+Punctuation
#     - Non-functional: "prefix+shift+\\"
#     - Non-functional: "prefix+shift+;"
#

# ---------------------------
# Meta: Prefix Modal Capture
# ---------------------------
#
# Known limitation: herdr has no key for sending the prefix through to a
# pane, so a literal ctrl+s cannot reach a pane while it is the prefix.
# ctrl+s is also the terminal's XOFF (flow-control stop), so programs
# expecting it (ie. nvim/zsh save or search maps) must use another key.
#
prefix = "ctrl+s"

# --------
# General
# --------
#
help          = "prefix+f1"
settings      = "prefix+f12"
detach        = "prefix+q"
reload_config = "prefix+shift+esc"

goto            = "prefix+g"
zoom            = "prefix+z"
copy_mode       = "prefix+y"
toggle_sidebar  = "prefix+b"
edit_scrollback = "prefix+e"

#
# ...+plain
# n - New
# r - Rename
# d - Delete
#
# prefix+...
#       - Pane
# shift - Tab
# ctrl  - Workspace
# alt   - Resize (prefix+alt+h/j/k/l) and worktrunk (prefix+alt+g/m)
#
# ctrl+alt - Direct (prefix-less) focus: tab, workspace, agent
#

# ------------------
# Modal: Navigation
# ------------------
# https://herdr.dev/tui/docs/config-reference/#:~:text=keys%2Eworkspace%5Fpicker

workspace_picker        = "prefix+w"
navigate_pane_up        = "k"
navigate_pane_down      = "j"
navigate_pane_left      = "h"
navigate_pane_right     = "l"
navigate_workspace_up   = "ctrl+k"
navigate_workspace_down = "ctrl+j"

# -----
# Pane
# -----

# Pane: Manage
split_vertical   = "prefix+\\"
split_horizontal = "prefix+;"
rename_pane      = "prefix+r"
# Free prefix+r for rename_pane; resize uses explicit resize_pane_* below
resize_mode      = ""
close_pane       = "prefix+d"

# Pane: Focus
# Behind the prefix, not bare ctrl+h/j/k/l: herdr intercepts direct
# bindings before the pane, which would steal ctrl+j/k (nvim completion,
# fzf), ctrl+h (nvim harpoon, BS) and ctrl+l (zsh clear-screen).
# ctrl+alt+h/j/k/l was rejected: legacy terminals send ESC + 0x08/0x0a,
# which collide with alt+backspace and alt+enter. prefix+h/j/k/l is free
# here and always deliverable.
focus_pane_left  = "prefix+h"
focus_pane_down  = "prefix+j"
focus_pane_up    = "prefix+k"
focus_pane_right = "prefix+l"
last_pane        = "ctrl+space"
# I question the value of these
# cycle_pane_next     = "ctrl+alt+tab"
# cycle_pane_previous = "ctrl+alt+shift+tab"

# Pane: Move
swap_pane_left  = "prefix+shift+h"
swap_pane_down  = "prefix+shift+j"
swap_pane_up    = "prefix+shift+k"
swap_pane_right = "prefix+shift+l"

# Pane: Resize
resize_pane_left  = "prefix+alt+h"
resize_pane_down  = "prefix+alt+j"
resize_pane_up    = "prefix+alt+k"
resize_pane_right = "prefix+alt+l"

# ----
# Tab
# ----

# Tab: Manage
new_tab    = "prefix+shift+n"
rename_tab = "prefix+shift+r"
close_tab  = "prefix+shift+d"

# Tab: Focus
next_tab     = "ctrl+alt+right"
previous_tab = "ctrl+alt+left"
switch_tab   = "prefix+1..9"

# Tab: Move
move_tab_previous = "prefix+shift+left"
move_tab_next     = "prefix+shift+right"

# ----------
# Workspace
# ----------

# Workspace: Manage
new_workspace    = "prefix+ctrl+n"
rename_workspace = "prefix+ctrl+r"
close_workspace  = "prefix+ctrl+d"

# Workspace: Focus
previous_workspace = "ctrl+alt+up"
next_workspace     = "ctrl+alt+down"
switch_workspace   = "prefix+ctrl+1..9"

# ------
# Agent
# ------

# Agent: Focus
previous_agent           = "ctrl+alt+shift+left"
next_agent               = "ctrl+alt+shift+right"
focus_agent              = "ctrl+alt+1..9"
# >tfw no 'rename_agent'
open_notification_target = "ctrl+alt+enter"        # Pending #1379

# --------------------
# [DISABLED] Worktree
# --------------------
#
# Native worktree interface constrains worktrees to a unified directory
# of layered repository and worktree scoping. Herdr dialog fails to trigger
# worktrunk hooks (See worktrunk.* of keys_cmd).
#
# Disabled entirely for integration with external utility 'worktrunk'.
new_worktree    = ""
open_worktree   = ""
remove_worktree = ""
