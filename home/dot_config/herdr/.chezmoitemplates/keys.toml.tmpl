[keys]
# --------------
# Keymap Syntax
# --------------
#
# | System | Modifier | Punctuation |
# | ------ | -------- | ----------- |
# | esc    | ctrl     | plus        |
# | tab    | alt      | minua       |
# | up     | shift    | comma       |
# | down   | super    | backtick    |
# | enter  | cmd      | ampersand   |
# | left   | meta     | semicolon   |
# | right  | hyper    | apostrophe  |
#
# ** Modal Invocation **
#
# - Benefits
#   - Scoped capture trigger efficaciously addresses map pollution and
#     collision.
#   - Facilitates personalisation and accessility for esoteric interface
#     (ie. one-handed while eating), and bespoke/idiomatic assignment.
#
# - Hindrance
#   - Necessitates preparatory key capture trigger, id est prefix.
#   - Instrinsically slower and of greater friction.
#   - The same as the last two items, now thrice.
#
# ** Activation Reliability **
#
# - Dependable:
#   - "ctrl+<letter>"
#   - Function keys
#
# - Environment Dependant:
#   - "alt+..."
#   - "cmd/super"
#
# - Logged Faliure
#   - Modifier+Punctuation
#     - Non-functional: "prefix+shift+\\"
#     - Non-functional: "prefix+shift+;"
#

# ---------------------------
# Meta: Prefix Modal Capture
# ---------------------------
#
# I nned to configure a passthrough, something like:
#
#   trigger = "prefix+ctrl+s"
#   action = { send_keys = "ctrl+s" }
#
# Whatever the object structure be, it's essential and belongs
# within this same file alongside this prefix definition.
#
prefix = "ctrl+s"

# --------
# General
# --------
#
help          = "prefix+f1"
settings      = "prefix+f12"
detach        = "prefix+q"
reload_config = "prefix+shift+esc"

goto            = "prefix+g"
zoom            = "prefix+z"
copy_mode       = "prefix+y"
toggle_sidebar  = "prefix+b"
edit_scrollback = "prefix+e"

# -----
# Pane
# -----

# Pane: Manage
split_vertical   = "prefix+\\"
split_horizontal = "prefix+;"
rename_pane      = "prefix+shift+p"
close_pane       = "prefix+shift+backspace"

# Pane: Focus
focus_pane_left     = "prefix+h"
focus_pane_down     = "prefix+j"
focus_pane_up       = "prefix+k"
focus_pane_right    = "prefix+l"
last_pane           = "prefix+space"
cycle_pane_next     = "prefix+tab"
cycle_pane_previous = "prefix+shift+tab"

# Pane: Move
swap_pane_left  = "prefix+shift+h"
swap_pane_down  = "prefix+shift+j"
swap_pane_up    = "prefix+shift+k"
swap_pane_right = "prefix+shift+l"

# Pane: Resize
resize_pane_left  = "prefix+alt+h"
resize_pane_down  = "prefix+alt+j"
resize_pane_up    = "prefix+alt+k"
resize_pane_right = "prefix+alt+l"

# ----
# Tab
# ----

# Tab: Manage
new_tab    = "prefix+t"
rename_tab = "prefix+shift+r"
close_tab  = "prefix+shift+w"

# Tab: Focus
next_tab     = "ctrl+alt+right"
previous_tab = "ctrl+alt+left"
switch_tab   = "prefix+1..9"

# Tab: Move
move_tab_previous = "prefix+,"  # <
move_tab_next     = "prefix+."  # >

# ----------
# Worksapce
# ----------

# Workspace: Manage
new_workspace    = "prefix+shift+n"
rename_workspace = "prefix+shift+r"
close_workspace  = "prefix+ctrl+w"

# Worksapce: Focus
previous_workspace = "ctrl+alt+up"
next_workspace     = "ctrl+alt+down"
workspace_picker   = "ctrl+alt+:"
switch_workspace   = "prefix+shift+1..9"

# ------
# Agent
# ------
#
# >tfw no 'rename_agent'

# Agent: Focus
previous_agent           = "ctrl+alt+,"
next_agent               = "ctrl+alt+."
focus_agent              = "prefix+alt+1..9"
open_notification_target = "ctrl+insert"      # Pending #1379


# --------------------
# [DISABLED] Worktree
# --------------------
#
# Native worktree interface constrains worktrees to a unified directory
# of layered repository and worktree scoping. Herdr dialog fails to trigger
# worktrunk hooks (See worktrunk.* of keys_cmd).
#
# Disabled entirely for integration with external utility 'worktrunk'.
new_worktree    = ""
open_worktree   = ""
remove_worktree = ""
