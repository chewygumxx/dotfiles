#
# Custom commands use the same binding syntax.
# type = "shell"  - Forked execution
# type = "pane"   - Ephemeral view until exit
# type = "popup"  - Modal view separate from tab layout
# Popup width and height accept terminal cells or percentages such as "80%".
#
# [[keys.command]]
# key     = "prefix+alt+g"
# command = "lazygit"
# type    = "popup"
# width   = "80%"
# height  = "80%"
#

# ---------------------
# Integrate: Worktrunk
# ---------------------

[[keys.command]]
key         = "prefix+shift+g"
description = "Switch to or create a worktree"
type        = "plugin_action"
command     = "worktrunk.open"

[[keys.command]]
key         = "prefix+alt+g"
description = "Remove a worktree"
type        = "plugin_action"
command     = "worktrunk.remove"

[[keys.command]]
key         = "prefix+alt+m"
description = "Merge a worktree into its target"
type        = "plugin_action"
command     = "worktrunk.merge"
