#
# https://herdr.dev/docs/configuration/
# https://herdr.dev/tui/docs/config-reference/
#

# --------------
# Agent
# Mouse
# Notification
# Pane
# Prompt
# Sidebar
# Sound
# Tab-Bar
# --------------

[ui]
# Theme: Accent Color
# - Hex  #7408cf
# - RGB  rgb(116, 8, 207)
# - Col  "cyan", "blue", "magenta"
accent = "#7408cf"

# Draw: Desktop/Mobile
# Minumum required columns to draw desktop TUI
mobile_width_threshold = 90

# Draw: Terminal Refocus
# Full redraw upon terminal refocus
#
# Set false to reduce visible flashing when switching back to Herdr.
# Disabling may necessitate alternative redraw trigger as contingency
# against surface corruption ie. false apparant unresponsiveness.
#
# https://herdr.dev/tui/docs/config-reference/#:~:text=ui%2Eredraw%5Fon%5Ffocus%5Fgained
#
redraw_on_focus_gained = true

# Draw: Cursor Style
# Cursor display rendering function
# - native  Attached terminal cursor.
# - drawn   Terminal cell content.
# - auto    Windows/WSL -> drawn
#           Otherwise   -> native
host_cursor = "auto"

# ------
# Mouse
# ------

# Mouse: Select-Copy
copy_on_select = true

# Mouse: Scroll Sensitivty
mouse_scroll_lines = 3

# Mouse: Herdr Capture
mouse_capture = false

# Mouse: RMB Passthrough
# One, or '+' concatenation, of:
# - ctrl
# - alt
# - super
# - cmd
# - meta
# - hyper
#
# Set "" to disable entirely (default)
#
# Explicitly Prohibited: "shift"
# Per conventional reservation by host terminal emulators
right_click_passthrough_modifier = ""

# -------
# Prompt
# -------

# Prompt: Confirm Workspace Close
confirm_close = true

# Prompt: Name of New Tab
prompt_new_tab_name = false

# Prompt: Name of New Workspace
prompt_new_workspace_name = true

# -----
# Pane
# -----

# Draw: Border of Split Pane
pane_borders = true

# Draw: Border of Pane Enclosure
pane_outer_borders = true

# Draw: Pane Scrollbar
pane_scrollbars = false

# Draw: Pane Intimacy
# Japanese Metro vs. Korean Border
pane_gaps = true

# Draw: Pane Border as Agent Collar
show_agent_labels_on_pane_borders = true

# --------
# Tab-Bar
# --------

# Draw: Tab Bar Loneliness
hide_tab_bar_when_single_tab = false

# Draw: Tab Bar Position
# - top
# - bottom
tab_bar_position = "bottom"

# Draw: Tab Bar Dashboard
# [Tokens] zoom
#          hostname
#          datetime
#          text
#          command
#
tab_bar_right           = []
tab_bar_right_separator = " "

# Window Title of Attached Terminal
# [Tokens] {pane}
#          {tab}
#          {workspace}
#          {hostname}
#          {terminal_title}
#
window_title = ""

# --------
# Sidebar
# --------

# Panel: Width
sidebar_width           = 26
sidebar_min_width       = 18
sidebar_max_width       = 36
sidebar_start_collapsed = false
sidebar_collapsed_mode  = "compact"  # "compact" or "hidden"

# Panel: Status Symbol
# - dots
# - symbols
status_indicators = "dots"

# Panel: Agent Order/Sort
# - priority
# - spaces
agent_panel_sort = "spaces"

# Panel: Entity Profile
# [Builtin] - state_icon
#           - state_text
#           - pane
#           - tab
#           - workspace
#           - terminal_title
#           - terminal_title_stripped
#
# [Custom]  Values reported via pane
#           metadata as: $<token-name>
#
# [Styling] { token = "workspace", fg = "#89b4fa", bold = true, dim = false }.
#
# https://herdr.dev/tui/docs/config-reference/#:~:text=ui%2Esidebar%2Eagents%2Erow%5Fgap
[ui.sidebar.spaces]
row_gap = 1
rows    = [ [ "state_icon", "workspace" ], [ "branch", "git_status" ] ]

[ui.sidebar.agents]
row_gap = 1
rows    = [ [ "state_icon", "agent" ], [ "workspace" ], [ "tab", "pane" ], [ "terminal_title_stripped" ] ]


# -------------
# Notification
# -------------
# https://herdr.dev/tui/docs/config-reference/#:~:text=Notifications

[ui.toast]
# Popup Delivery
# - 'herdr'    Herdr drawn within host
# - 'terminal' Desktop notify via host terminal request
# - 'system'   Direct message via host operating system
# - 'off'      Disable entirely
delivery = "herdr"

# Delay: Event -> Notify
# Mimumum time to validate change of agent status
delay_seconds = 10

# Draw: Herdr Popup
herdr = { position = "top-right" }

# Draw: Copied-to-Clipboard
clipboard = { position = "top-right", enabled = true }

# ------
# Sound
# ------

[ui.sound]
enabled = true

# MP3 Filepath
# Absolute or relative to configuration file.
#
# path         = "./all-events.mp3"
# done_path    =
# request_path =

[ui.sound.agents]
# "on" vs "off" vs "default"
pi             = "default"
claude         = "default"
codex          = "default"
gemini         = "default"
cursor         = "default"
devin          = "default"
agy            = "default"
cline          = "default"
open_code      = "default"
kimi           = "default"
kiro           = "default"
droid          = "default"
amp            = "default"
grok           = "default"
hermes         = "default"
kilo           = "default"
qodercli       = "default"
qwen           = "default"
letta          = "default"
maki           = "default"
use            = "default"
github_copilot = "default"
