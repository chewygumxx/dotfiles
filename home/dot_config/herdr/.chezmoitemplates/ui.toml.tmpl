# https://herdr.dev/tui/docs/config-reference/
#

# --------------
# Agent
# Mouse
# Notification
# Pane
# Prompt
# Sidebar
# Sound
# Tab-Bar
# --------------

[ui]
# Theme: Accent Color
# - Hex  #7408cf
# - RGB  rgb(116, 8, 207)
# - Col  "cyan", "blue", "magenta"
accent = "#7408cf"

# Draw: Desktop/Mobile
# Minimum required columns to draw desktop TUI
mobile_width_threshold = 90

# Draw: Terminal Refocus
# Full redraw upon terminal refocus
#
# Set false to reduce visible flashing when switching back to Herdr.
# Disabling may necessitate alternative redraw trigger as contingency
# against surface corruption ie. false apparent unresponsiveness.
#
# https://herdr.dev/tui/docs/config-reference/#:~:text=ui%2Eredraw%5Fon%5Ffocus%5Fgained
#
redraw_on_focus_gained = true

# Draw: Cursor Style
# Cursor display rendering function
# - native  Attached terminal cursor.
# - drawn   Terminal cell content.
# - auto    Windows/WSL -> drawn
#           Otherwise   -> native
host_cursor = "auto"

# ------
# Mouse
# ------

# Mouse: Select-Copy
copy_on_select = true

# Mouse: Scroll Sensitivity
mouse_scroll_lines = 3

# Mouse: Herdr Capture
mouse_capture = true

# Mouse: RMB Passthrough
# One, or '+' concatenation, of:
# - ctrl
# - alt
# - super
# - cmd
# - meta
# - hyper
#
# Set "" to disable entirely (default)
#
# Explicitly Prohibited: "shift"
# Per conventional reservation by host terminal emulators
right_click_passthrough_modifier = ""

# -------
# Prompt
# -------

# Prompt: Confirm Workspace Close
confirm_close = true

# Prompt: Name of New Tab
prompt_new_tab_name = false

# Prompt: Name of New Workspace
prompt_new_workspace_name = true

# -----
# Pane
# -----

# Draw: Border of Split Pane
pane_borders = true

# Draw: Border of Pane Enclosure
pane_outer_borders = true

# Draw: Pane Scrollbar
pane_scrollbars = false

# Draw: Pane Intimacy
# Japanese Metro vs. Korean Border
pane_gaps = true

# Draw: Pane Border as Agent Collar
show_agent_labels_on_pane_borders = true

# --------
# Tab-Bar
# --------

# Draw: Tab Bar Loneliness
hide_tab_bar_when_single_tab = false

# Draw: Tab Bar Position
# - top
# - bottom
tab_bar_position = "top"

# Draw: Tab Bar Dashboard
# [Tokens] zoom
#          hostname
#          datetime
#          text
#          command
#
tab_bar_right           = []
tab_bar_right_separator = " "

# Window Title of Attached Terminal
# [Tokens] {pane}
#          {tab}
#          {workspace}
#          {hostname}
#          {terminal_title}
#
window_title = ""

# --------
# Sidebar
# --------

# Panel: Width
sidebar_width           = 26
sidebar_min_width       = 18
sidebar_max_width       = 36
sidebar_start_collapsed = false
sidebar_collapsed_mode  = "compact"  # "compact" or "hidden"

# Panel: Status Symbol
# - dots
# - symbols
status_indicators = "dots"

# Panel: Agent Order/Sort
# - priority
# - spaces
agent_panel_sort = "priority"
