{{- /*
#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_config/herdr/config.toml.tmpl
#
#

# Each top-level key belongs to one settings fragment.
*/ -}}

{{- $dir := joinPath .chezmoi.sourceDir (dir .chezmoi.sourceFile) "settings" -}}
{{- $files := glob (joinPath $dir "*.toml") -}}
{{- if not $files -}}
    {{- fail (printf "no Herdr settings fragments in %s" $dir) -}}
{{- end -}}

{{- $settings := dict -}}
{{- range $files -}}
    {{- $file := . -}}
    {{- range $key, $value := (include $file | fromToml) -}}
        {{- if hasKey $settings $key -}}
            {{- fail (printf "%s: duplicate Herdr setting %q" (base $file) $key) -}}
        {{- end -}}
        {{- $_ := set $settings $key $value -}}
    {{- end -}}
{{- end -}}

{{- with dig "ui" "sound" (dict) $settings -}}
    {{- $sound := . -}}
    {{- $audioDir := joinPath $.chezmoi.destDir ".local" "share" "audio" -}}
    {{- $sounds := dig "herdr" "notifymp3" (dict) $ -}}
    {{- range $key, $override := dict "path" "std" "done_path" "done" "request_path" "request" -}}
        {{- if hasKey $sound $key -}}
            {{- $name := get $sounds $override | default (get $sound $key) -}}
            {{- $_ := set $sound $key (joinPath $audioDir $name) -}}
        {{- end -}}
    {{- end -}}
    {{- $overrides := dig "herdr" "ui_sound_agents" (dict) $ -}}
    {{- with get $sound "agents" -}}
        {{- $agents := . -}}
        {{- range $agent, $fallback := $agents -}}
            {{- $_ := set $agents $agent (get $overrides $agent | default $fallback) -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
# Generated by chezmoi from home/dot_config/herdr/settings/*.toml.
{{ toToml $settings -}}
