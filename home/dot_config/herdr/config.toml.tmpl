#
# [Masterdoc] Configuration fragments under `./.chezmoitemplates/` are
# inclusively assembled within this file upon `chezmoi apply`.
#
# https://herdr.dev/docs/configuration/
#

# First-time user introductory tutorial
onboarding = false

# Size of the virtual terminal used when no client is attached.
# Attached clients always use their own terminal size.
[server]
# Set smaller for potential Termux interfacing
# Default: 120
headless_cols = 76
# Default: 40
headless_rows = 40

[terminal]
# Executable used for new interactive panes. Empty means $SHELL, then /bin/sh.
# Default: ""
default_shell = ""

# Startup mode for new interactive pane shells: "auto", "login", or "non_login".
# Default: "auto"
shell_mode = "auto"

# Default cwd for new shells.
# - "follow" inherit the source pane/workspace,
# - "home"
# - "current" for Herdr's process directory
# - Fixed path such as "~/Projects".
# Default: "follow"
new_cwd = "follow"

[session]
# Resume supported AI-agent panes into their native conversation sessions after
# a Herdr server restart. Requires official integrations that report session refs.
# Default: true
resume_agents_on_restore = true

[advanced]
# Maximum scrollback buffer size in bytes retained per pane terminal.
# scrollback_limit_bytes = 10000000

[worktrees]
directory = "~/dev/_worktree"

[remote]
manage_ssh_config = false

[experimental]
# They put a herdr _inside_ a herdr `xzibit.jpeg`
allow_nested   = false
# Computationally expensive
kitty_graphics = false
# Save recent pane screen history across full server restarts.
pane_history   = true
# cjk_ime_agents = []
# cjk_ime_cursor_shape = "steady_block"
# reveal_hidden_cursor_for_cjk_ime = false

[update]
version_check  = true
manifest_check = true
channel        = "stable"

