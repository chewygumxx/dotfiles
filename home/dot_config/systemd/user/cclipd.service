[Unit]
Description="Clipboard capture daemon: cclipd"
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=cclipd -S -t "image/png" -t "image/*" -t "text/plain;charset=utf-8" -s 2

[Install]
WantedBy=hyprland-post.target
