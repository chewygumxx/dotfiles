#
# Ensures recursive ownership of Ollama model download directory
# User-Specified Path:  "$OLLAMA_MODELS"
# Recursive Ownership:  ollama:ollama
#
# Dependant upon executable: ~/.local/bin/service-script-ollama-chown-dir
#
# https://docs.ollama.com/faq#:~:text=ollama%3Aollama
#

[Unit]
Description=Executes script to ensure the directory path defined by OLLAMA_MODELS, if set, has recursive ownership of ollama:ollama
Documentation=https://docs.ollama.com/faq#:~:text=ollama%3Aollama
ConditionEnvironment=OLLAMA_MODELS

[Service]
Type=oneshot
ExecStart=%h/.local/bin/service-script-ollama-chown-dir
RemainAfterExit=no

[Install]
WantedBy=default.target
