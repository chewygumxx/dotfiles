#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_config/systemd/user/ssh-agent-openssh.socket
#
#

#
# Currently disabled during Proton Pass SSH agent trial
#

[Unit]
Description=Socket for the OpenSSH key agent
Documentation=man:ssh-agent(1)
ConditionEnvironment=!SSH_AGENT_PID

[Socket]
ListenStream=%t/ssh-agent-openssh.socket
RemoveOnStop=yes

[Install]
WantedBy=sockets.target

