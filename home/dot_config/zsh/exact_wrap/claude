#!/bin/false
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_config/zsh/exact_wrap/claude
#
#

#
# Wrapper function as configuration
#
# `claude doctor`
# https://code.claude.com/docs/en/settings
# https://code.claude.com/docs/en/cli-reference
#

(($+commands[claude])) || return 127

emulate -L zsh
setopt localoptions extended_glob

local __this_file="${(D)${${(%):-%N}:A}}"

# ------------
# Directories
# ------------

: "${XDG_DATA_HOME:="$HOME/.local/share"}"
: "${CLAUDE_CONFIG_DIR:="$XDG_DATA_HOME/claude"}"

if [[ ! -d "$CLAUDE_CONFIG_DIR" ]]; then
    command mkdir -p "$CLAUDE_CONFIG_DIR" || return $?
fi

local -x CLAUDE_CONFIG_DIR

if [[ ! -v CLAUDE_CODE_PROJECT_DIR_NAME ]]; then
    local git_origin{,_trim} git_slug

    # Quiet on purpose. Outside a repository, or in one without an origin, git
    # printed its complaint on every launch; the fallback name below already
    # covers both cases.
    git_origin="$(command git -C "$PWD" remote get-url origin 2> /dev/null)"
    git_origin_trim="${${git_origin##*:}%\.git}"
    git_slug="${(j:_:)${${(s:/:)git_origin_trim}[-2,-1]}}"
    git_slug="${git_slug// /_}"

    # POSIX portable filename charset
    git_slug="${git_slug//[^A-Za-z0-9._-]/_}"
    git_slug="${git_slug//_##/_}"
    git_slug="${git_slug##[-._]##}"
    git_slug="${git_slug%%[-._]##}"
    git_slug="${git_slug:-project}"

    : "${CLAUDE_CODE_PROJECT_DIR_NAME:="$git_slug"}"
fi

local -x CLAUDE_CODE_PROJECT_DIR_NAME

# ----------
# Utilities
# ----------

# Always utilise locally installed ripgrep
if ! (($+commands[rg])); then
    builtin printf -u2 -f '%s: [%s] %s\n' -- \
        "$__this_file" "ERROR" "Not found: rg" \
        "$__this_file" "ERROR" '    (Bypass this blocker with `command claude [args]`'
    return 127
fi

local -x USE_BUILTIN_RIPGREP=0

# ----------
# Telemetry
# ----------

local -x DO_NOT_TRACK=1
local -x DISABLE_TELEMETRY=1
local -x DISABLE_GROWTHBOOK=1
local -x CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# --------
# Execute
# --------

command claude "$@"
