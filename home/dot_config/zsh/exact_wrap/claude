#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_config/zsh/exact_wrap/claude
#
#

#
# Wrapper function as configuration
#
# `claude doctor`
# https://code.claude.com/docs/en/settings
# https://code.claude.com/docs/en/cli-reference
#

(($+commands[claude])) || return 127

emulate -L zsh
setopt localoptions extended_glob

# functions_source, not %N:A. In an autoloaded function %N is the bare
# function name, so :A resolved it against $PWD rather than fpath.
local __this_file="${(D)${functions_source[${(%):-%N}]:-${(%):-%N}}}"

__debug() {
    ((CGXX_DEBUG)) && return
    printf -u2 -f '%s: [%s] %s\n' -- "$__this_file" DEBUG "$*"
}

__info() {
    ((CGXX_QUIET)) && return
    printf -u2 -f '%s: [%s] %s\n' -- "$__this_file" INFO "$*"
}

__info "-- Wrapper Function for Claude Code"

# ------------
# Directories
# ------------

# Declared local before defaulting. `: ${VAR:=...}` on its own assigned the
# caller's global variable, so the defaults leaked into the interactive shell.
local XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
local -x CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$XDG_DATA_HOME/claude}"

if [[ ! -d "$CLAUDE_CONFIG_DIR" ]]; then
    local code=0
    if command mkdir -p "$CLAUDE_CONFIG_DIR"; then :; else
        code="$?"
        builtin printf -u2 -f '%s: [%s] %s:\n    %s\n' -- \
            "$__this_file" FATAL \
            "Failed to both resolve and create CLAUDE_CONFIG_DIR:" \
            "$CLAUDE_CONFIG_DIR"
        return "$code"
    fi
fi

__debug "CLAUDE_CONFIG_DIR --> $CLAUDE_CONFIG_DIR"

# TODO: Review the value in storing memory within claude project
# directories dedicated to emphermal worktrees
#
# gh_<owner>_<repo>___<branch>, each part slugged, from the origin remote.
# Read from git rather than `gh repo view`, which is an API round-trip on
# every launch, has no -C flag and no branch field. Left unset outside a
# GitHub checkout, where it used to be exported empty. Empty counts as
# unset, so a value inherited empty from an older run is recomputed.
if [[ -z "${CLAUDE_CODE_PROJECT_DIR_NAME:-}" ]]; then
    # Local and unset, so an inherited empty value is not passed on when
    # nothing is computed below.
    local -x CLAUDE_CODE_PROJECT_DIR_NAME
    unset CLAUDE_CODE_PROJECT_DIR_NAME

    local remote branch
    if remote="$(command git remote get-url origin 2> /dev/null)" &&
        [[ "$remote" == (#b)(*[@/])github.com[:/]([^/]##)/([^/]##) ]]; then
        local -a parts=("$match[2]" "${match[3]%.git}")
        branch="$(command git branch --show-current 2> /dev/null)"
        parts+=("${branch:-detached}")

        local part
        local -a slugs
        for part in "$parts[@]"; do
            part="${${(L)part}//[^a-z0-9]##/-}"
            part="${${part##-##}%%-##}"
            slugs+=("${part:-untitled}")
        done

        local name="gh_${slugs[1]}_${slugs[2]}___${slugs[3]}"
        export CLAUDE_CODE_PROJECT_DIR_NAME="${name[1,100]}"
    fi
fi

__info "CLAUDE_CODE_PROJECT_DIR_NAME --> $CLAUDE_CODE_PROJECT_DIR_NAME"

# ----------
# Utilities
# ----------

local -x USE_BUILTIN_RIPGREP=0

# Always utilise locally installed ripgrep
if ! (($+commands[rg])); then
    local -x USE_BUILTIN_RIPGREP=1

    builtin printf -u2 -f '%s: [%s] %s\n\n    %s\n\n%s\n' -- \
        "$__this_file" "ERROR" \
        "Essential utility not found:" "rg (ripgrep)" \
        "Falling back to builtin"
fi

# ----------
# Telemetry
# ----------

local -x DO_NOT_TRACK=1
local -x DISABLE_TELEMETRY=1
local -x DISABLE_GROWTHBOOK=1
local -x CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# --------
# Execute
# --------

command claude "$@"
