(($+commands[claude])) || return 127

emulate -L zsh
setopt localoptions extended_glob

# functions_source, not %N:A. In an autoloaded function %N is the bare
# function name, so :A resolved it against $PWD rather than fpath.
local __this_file="${(D)${functions_source[${(%):-%N}]:-${(%):-%N}}}"

__debug() {
    ((CGXX_DEBUG)) || return 0
    builtin print -u2 -f '%s: [%s] %s\n' -- "$__this_file" DEBUG "$*"
}

__info() {
    ((CGXX_QUIET)) && return 0
    builtin print -u2 -f '%s: [%s] %s\n' -- "$__this_file" INFO "$*"
}

__info "-- Wrapper Function for Claude Code"

# Firefox tabs and this are not a vibe
