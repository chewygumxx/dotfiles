local -x CLAUDE_CODE_DISABLE_FILE_MENTIONS=1
local -x CLAUDE_CODE_DISABLE_AGENT_VIEW=1
local -x CLAUDE_CODE_DISABLE_ARTIFACT=1
local -x CLAUDE_CODE_DISABLE_ATTACHMENTS=1
local -x CLAUDE_CODE_DISABLE_AUTH_REFRESH_LOCK=1
local -x CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=0
local -x CLAUDE_CODE_DISABLE_CFC_PROMPT=1
local -x CLAUDE_CODE_DISABLE_CRON=1
local -x CLAUDE_CODE_DISABLE_DANGEROUS_RM_TIMEOUT=1
local -x CLAUDE_CODE_DISABLE_DEFERRED_TOOL_RESUME=1
local -x CLAUDE_CODE_DISABLE_FAST_MODE=1
local -x CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
local -x CLAUDE_CODE_SEND_FEEDBACK=1

local -x DISABLE_INSTALL_GITHUB_APP_COMMAND=1
local -x CLAUDE_CODE_WEBFETCH_CACHE_TTL_MS="86400000"

local -x CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX="chewytop"
local -x CLAUDE_CODE_TMPDIR="/tmp/agents"

local -x DISABLE_AUTO_COMPACT=1
local -x DISABLE_AUTOUPDATER=0
local -x DISABLE_COST_WARNINGS=1
local -x DISABLE_EXTRA_USAGE_COMMAND=1

# Set by Claude in processes they create
# Don't set it here lmao
