#USAGE bin "commit-message"
#USAGE about "Write a commit message for the prompt on stdin"
#USAGE long_about """
#USAGE The commit.generation command, used by `wt step commit` and `wt merge`.
#USAGE Runs Claude Code headless with no tools, no system prompt, no
#USAGE thinking and no saved session, reading worktrunk's prompt from stdin
#USAGE and printing the message.
#USAGE """
#USAGE example "git diff --cached | commit-message" header="Try it by hand"
#USAGE flag "-m --model <model>" default="haiku" help="Claude model"

setopt err_exit pipe_fail no_unset

local -a args=(
    --print
    --model=$usage_model

    --tools=''
    --safe-mode
    --system-prompt=''
    --setting-sources='user'
    --no-session-persistence
)

MAX_THINKING_TOKENS=0 exec claude $args
