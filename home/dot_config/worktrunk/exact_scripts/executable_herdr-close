#USAGE bin "herdr-close"
#USAGE about "Close the herdr workspaces left on a removed worktree"
#USAGE long_about """
#USAGE The post-remove hook. A removed worktree's shells otherwise sit in a
#USAGE deleted directory. Covers `wt remove` and `wt merge` from a shell;
#USAGE skipped inside herdr-worktrunk plugin panes (HERDR_PLUGIN_ROOT set),
#USAGE whose remover and merger close it themselves. herdr still lists the
#USAGE workspace's checkout_path after the directory is gone. This closes
#USAGE every pane in those workspaces.
#USAGE """
#USAGE arg "<path>" help="The removed worktree, {{ worktree_path }}"

setopt err_exit pipe_fail no_unset

[[ ${HERDR_ENV:-} == 1 && -z ${HERDR_PLUGIN_ROOT:-} ]] || exit 0

local ws
herdr workspace list |
    jq --raw-output --arg p $usage_path '.result.workspaces[]
        | select(.worktree.checkout_path == $p) | .workspace_id' |
    while read -r ws; do
        herdr workspace close $ws >/dev/null
    done
