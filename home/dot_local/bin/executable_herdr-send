#!/usr/bin/env zsh
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only
#
#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_local/bin/executable_herdr-send
#
#
#
# @file herdr-send
# @brief
#     Sends a message to an agent in a herdr pane
# @description
#     Reads text stdin, textwraps with markdown awareness at width of
#     80 characters, sends it as text to a herdr pane hosting an agent, and
#     successively sends the key 'enter'.
#
# @option -d<date> | --date=<date>
#     `systemd-run --user --unit=herdr-send-<agent>-<stamp>
#     --on-calendar=<date>`, where <stamp> is the scheduling time in
#     nanoseconds since the epoch, so any number of sends may be pending for
#     the same agent
#
# @arg $1
#     Herdr hosted agent
# @stdin
#     Message

emulate -L zsh

# @internal
# @description
#     Prints message (if provided) and exits with code provided by option or 1
#
# @option -<number>
#     Exit code
# @arg $*
#     Message
fatal() {
    if [[ "$1" == -<-> ]]; then
        local exit="${1#-}"
        shift
    fi

    (( $# )) && print -u2 -f $'\e[1mherdr-send\e[0m: %s\n' -- \
        "$(print -r -- "$*" | fmt --width 80)"
    exit "${exit:-1}"
}

# @internal
# @description
#     Runs a herdr API command, printing its result JSON, or dies with the
#     message of its error JSON
#
# @arg $@
#     herdr arguments
api() {
    local reply
    reply="$(herdr "$@" 2>&1)" && { print -r -- "$reply"; return }
    fatal \
        "${$(jq -r '.error.message // empty' 2>/dev/null <<< "$reply"):-$reply}"
}

local -a opt_date
zparseopts -D -E -F -- d:=opt_date -date:=opt_date || exit 2
[[ "$1" == -- ]] && shift
(( $# == 1 )) || fatal -2 "expected exactly 1 agent, got $#"
local agent="$1"
# The last occurrence wins; `--date=<date>` leaves its `=` on the argument
local date="${opt_date[-1]#=}"

local message
message="$(prettier --no-config --no-editorconfig --parser markdown \
    --prose-wrap always --print-width 80)" \
    || fatal 'failed to wrap message'
[[ "$message" == *[^[:space:]]* ]] || fatal 'empty message on stdin'

# Deferred sends re-run this script from a transient timer, handing it the
# already wrapped message back on stdin via StandardInputData=
if [[ -n "$date" ]]; then
    local -a setenv=(--setenv=PATH)
    [[ -n "$HERDR_SOCKET_PATH" ]] && setenv+=(--setenv=HERDR_SOCKET_PATH)

    # Characters a unit name can't hold become `_`, rather than systemd-escape
    # mangling the common `-` into `\x2d`. The stamp keeps each pending send
    # its own unit. Timers otherwise coalesce to fire up to a minute late.
    zmodload -F zsh/datetime p:EPOCHREALTIME
    exec systemd-run --user --collect \
        --unit="herdr-send-${agent//[^[:alnum:]:_.-]/_}-${EPOCHREALTIME/./}" \
        --on-calendar="$date" \
        --timer-property=AccuracySec=1s \
        "${setenv[@]}" \
        --property=StandardInputData="$(print -rn -- "$message" | base64 -w0)" \
        -- "${0:A}" "$agent"
fi

# Not `agent prompt`, which writes the text and enter as one submission: an
# agent such as Claude Code swallows an enter arriving with a bracketed paste,
# leaving the message unsent in its input. Its refusal of blocked agents is
# kept, as text typed into an approval dialog could answer it.
local agent_json pane
agent_json="$(api agent get "$agent")" || exit
pane="$(jq -r .result.agent.pane_id <<< "$agent_json")"
[[ "$(jq -r .result.agent.agent_status <<< "$agent_json")" != blocked ]] \
    || fatal "agent $agent is blocked on a dialog"

# Sends to the same pane at once (eg. deferred to the same time) could
# otherwise interleave, merging into one message with a later bare enter
zmodload -F zsh/system b:zsystem
local lock="${XDG_RUNTIME_DIR:-/tmp}/herdr-send-${pane//[^[:alnum:]]/_}.lock"
local lock_fd
# zsystem flock won't create its file
{ : >> "$lock" && zsystem flock -f lock_fd "$lock" } \
    || fatal "failed to lock pane $pane"

api pane send-text "$pane" "$message" > /dev/null || exit
api pane send-keys "$pane" enter > /dev/null || exit
