#!/bin/sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_local/bin/executable_node
#
#

#
# Shadow wrapper script as configuration
#

: "${XDG_STATE_HOME:=$HOME/.local/state}"
# No colon on the second default: Node documents an empty string (or a single
# space) as the switch that disables persistent history, so an explicitly empty
# value must be preserved rather than treated as unset.
: "${NODE_REPL_HISTORY=$XDG_STATE_HOME/node_repl_history}"
export NODE_REPL_HISTORY

__this_name=${0##*/}

log() {
    printf '[shadow] %s: %s\n' "$__this_name" "$*" >&2
}

fatal() {
    __code=$1
    shift
    log "$@"
    exit "$__code"
}

# Locate the next executable of the same name on PATH after this file. Never
# look behind it: an earlier entry (e.g. a mise shim resolving "system") may
# fall back to PATH-minus-itself, landing here again and looping forever.
# Only when this file is not on PATH at all is the first match taken.
# "-ef" compares device and inode, so symlinks, trailing slashes and
# alternate spellings of this file's path are all handled correctly.
__real=''
__first=''
__past_self=''
set -f
IFS=:
for __dir in $PATH; do
    [ -n "$__dir" ] || continue
    __candidate="$__dir/$__this_name"
    [ -f "$__candidate" ] && [ -x "$__candidate" ] || continue
    if [ "$__candidate" -ef "$0" ]; then
        __past_self=1
        continue
    fi
    [ -n "$__first" ] || __first="$__candidate"
    if [ -n "$__past_self" ]; then
        __real="$__candidate"
        break
    fi
done
unset IFS
set +f
[ -n "$__past_self" ] || __real="$__first"

[ -n "$__real" ] || fatal 127 'Shadowed executable not found'

# Best-effort creation of the history file's parent directory. Node will not
# create it and silently skips persistence if it is missing. Failure is
# deliberately non-fatal so that non-interactive callers (LSP servers, build
# tools, CI) are never blocked by a history path they do not use.
case $NODE_REPL_HISTORY in
*/*)
    __hist_dir=${NODE_REPL_HISTORY%/*}
    [ -n "$__hist_dir" ] || __hist_dir=/
    ;;
*)
    __hist_dir=.
    ;;
esac
[ -d "$__hist_dir" ] || mkdir -p -m 0700 -- "$__hist_dir" 2>/dev/null || :

exec "$__real" "$@"
