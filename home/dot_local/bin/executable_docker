#!/bin/sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_local/bin/executable_docker
#
#

#
# Shadow wrapper script as configuration
#

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${DOCKER_CONFIG:=$XDG_CONFIG_HOME/docker}"
export DOCKER_CONFIG

__this_name=${0##*/}

log() {
    printf '[shadow] %s: %s\n' "$__this_name" "$*" >&2
}

fatal() {
    __code=$1
    shift
    log "$@"
    exit "$__code"
}

# Locate the next executable of the same name on PATH after this file. Never
# look behind it: an earlier entry (e.g. a mise shim resolving "system") may
# fall back to PATH-minus-itself, landing here again and looping forever.
# Only when this file is not on PATH at all is the first match taken.
# "-ef" compares device and inode, so symlinks, trailing slashes and
# alternate spellings of this file's path are all handled correctly.
__real=''
__first=''
__past_self=''
set -f
IFS=:
for __dir in $PATH; do
    [ -n "$__dir" ] || continue
    __candidate="$__dir/$__this_name"
    [ -f "$__candidate" ] && [ -x "$__candidate" ] || continue
    if [ "$__candidate" -ef "$0" ]; then
        __past_self=1
        continue
    fi
    [ -n "$__first" ] || __first="$__candidate"
    if [ -n "$__past_self" ]; then
        __real="$__candidate"
        break
    fi
done
unset IFS
set +f
[ -n "$__past_self" ] || __real="$__first"

[ -n "$__real" ] || fatal 127 'Shadowed executable not found'

# Best-effort creation of the configuration directory itself, private since it
# may hold registry credentials. The CLI would create it on first save anyway,
# so failure is deliberately non-fatal.
[ -d "$DOCKER_CONFIG" ] || mkdir -p -m 0700 -- "$DOCKER_CONFIG" 2>/dev/null || :

exec "$__real" "$@"
