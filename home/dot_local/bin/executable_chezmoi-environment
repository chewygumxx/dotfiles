#!/usr/bin/env bash
# vim:set noexpandtab shiftwidth=4 filetype=bash:

#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_local/bin/executable_chezmoi-environment
#
#

#
# Populate environments with chezmoi variables
#

set -eu

command -v chezmoi >/dev/null 2>&1 || exit 0

source_dir="$(chezmoi source-path)"
working_tree="$(git -C "$source_dir" rev-parse --show-toplevel)"

if command -v systemctl >/dev/null 2>&1; then
	systemctl --user set-environment \
		CHEZMOI_SOURCE_DIR="$source_dir" \
		CHEZMOI_WORKING_TREE="$working_tree"
fi

if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	hyprctl setenv CHEZMOI_SOURCE_DIR   "$source_dir"   >/dev/null
	hyprctl setenv CHEZMOI_WORKING_TREE "$working_tree" >/dev/null
fi

if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/env" ]; then
	cat > "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/env/chezmoi.env.zsh" <<-heredoc
		#!/bin/false
		# vim:set expandtab shiftwidth=4 filetype=zsh:

		#
		#
		# ~chewygumxx/dotfiles.git
		# ::: :${source_dir#${working_tree}}/dot_config/zsh/env/chezmoi.env.zsh
		#
		#

		#
		# [GENERATED FILE] Generated by: "${0}"
		# Populate environment with chezmoi variables
		#

		export CHEZMOI_SOURCE_DIR="$source_dir"
		export CHEZMOI_WORKING_TREE="$working_tree"

		heredoc
fi
