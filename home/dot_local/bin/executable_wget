#!/bin/sh
# vim:set expandtab shiftwidth=4 filetype=sh:

# 
# 
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_local/bin/executable_wget
#
#

#
# Shadow file as configuration
#

cache="${XDG_CACHE_HOME:-$HOME/.cache}/wget"
mkdir -p "$cache" || exit 1

exec command wget --hsts-file="$cache/wget-hsts" "$@"
