{{- /*
    ~chewygumxx/dotfiles.git
    ::: :/home/.chezmoitemplates/environment/resolve

    Resolves home/.chezmoidata/environment.toml for this host's .chezmoi.os,
    as JSON:

        {"variables": [{"name", "value", "inherit", "comment"}, ...],
         "path":      ["dir", ...],
         "byName":    {"NAME": "value", ...}}

    Each value is chosen for this OS, ${UID} is filled in, and entries absent
    on this OS are left out. Anything the consumers could not all expand the
    same way is refused with fail, naming the variable: see the value syntax
    in the data file's header.

    Usage: includeTemplate "environment/resolve" . | fromJson
*/ -}}

{{- $os := .chezmoi.os -}}
{{- $uid := toString .chezmoi.uid -}}
{{- $nameSyntax := `^[A-Za-z_][A-Za-z0-9_]*$` -}}
{{- $valueSyntax := printf `^([^$"'\\%s]|\$\{[A-Za-z_][A-Za-z0-9_]*\})*$` "`" -}}
{{- $reference := `\$\{[A-Za-z_][A-Za-z0-9_]*\}` -}}

{{- /* Names a value may reference: the builtins, then each variable once
       it has been defined. */ -}}
{{- $defined := dict "HOME" true "PREFIX" true "UID" true -}}
{{- $variables := list -}}
{{- $byName := dict -}}

{{- range .environment.variables -}}
{{-     $name := toString (get . "name") -}}
{{-     if not (regexMatch $nameSyntax $name) -}}
{{-         fail (printf "environment.toml: %q: not a variable name" $name) -}}
{{-     end -}}
{{-     if hasKey $defined $name -}}
{{-         fail (printf "environment.toml: %s: defined twice" $name) -}}
{{-     end -}}

{{- /* The value for this OS, if any. */ -}}
{{-     $value := "" -}}
{{-     $present := false -}}
{{-     if and (hasKey . "os") (hasKey .os $os) -}}
{{-         $value = index .os $os -}}
{{-         $present = true -}}
{{-     else if hasKey . "value" -}}
{{-         $value = .value -}}
{{-         $present = true -}}
{{-     end -}}

{{-     $inherit := false -}}
{{-     if hasKey . "inherit" -}}
{{-         $inherit = .inherit -}}
{{-         if not (kindIs "bool" $inherit) -}}
{{-             if not (and (kindIs "string" $inherit) (eq (toString $inherit) "ssh")) -}}
{{-                 fail (printf "environment.toml: %s: inherit must be true, false or \"ssh\"" $name) -}}
{{-             end -}}
{{-         end -}}
{{-     end -}}

{{-     if $present -}}
{{-         if not (kindIs "string" $value) -}}
{{-             fail (printf "environment.toml: %s: value must be a string" $name) -}}
{{-         end -}}
{{-         if not (regexMatch $valueSyntax $value) -}}
{{-             fail (printf "environment.toml: %s: %q may hold only text and ${NAME}" $name $value) -}}
{{-         end -}}
{{-         range regexFindAll $reference $value -1 -}}
{{-             $ref := trimSuffix "}" (trimPrefix "${" .) -}}
{{-             if not (hasKey $defined $ref) -}}
{{-                 fail (printf "environment.toml: %s: references ${%s}, which is not defined above it" $name $ref) -}}
{{-             end -}}
{{-         end -}}
{{-         $value = replace "${UID}" $uid $value -}}
{{-         $_ := set $defined $name true -}}
{{-         $_ := set $byName $name $value -}}
{{-         $variables = append $variables (dict
                "name"    $name
                "value"   $value
                "inherit" $inherit
                "comment" (toString (get . "comment"))) -}}
{{-     end -}}
{{- end -}}

{{- $path := list -}}
{{- range .environment.path.prepend -}}
{{-     $dir := "" -}}
{{-     if kindIs "string" . -}}
{{-         $dir = . -}}
{{-     else if has $os (get . "os") -}}
{{-         $dir = toString (get . "dir") -}}
{{-     end -}}
{{-     if $dir -}}
{{-         if not (regexMatch $valueSyntax $dir) -}}
{{-             fail (printf "environment.toml: PATH: %q may hold only text and ${NAME}" $dir) -}}
{{-         end -}}
{{-         range regexFindAll $reference $dir -1 -}}
{{-             $ref := trimSuffix "}" (trimPrefix "${" .) -}}
{{-             if not (hasKey $defined $ref) -}}
{{-                 fail (printf "environment.toml: PATH: %q references ${%s}, which is not defined" $dir $ref) -}}
{{-             end -}}
{{-         end -}}
{{-         $path = append $path (replace "${UID}" $uid $dir) -}}
{{-     end -}}
{{- end -}}

{{- dict "variables" $variables "path" $path "byName" $byName | toJson -}}
