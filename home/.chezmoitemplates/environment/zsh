{{- /*
    ~chewygumxx/dotfiles.git
    ::: :/home/.chezmoitemplates/environment/zsh

    Renders the registry as zsh, for a file .zshenv sources from inside an
    anonymous function: export is typeset -gx, so nothing ends up local.
    inherit = true becomes : "${NAME:=value}"; inherit = "ssh" keeps an
    inherited value only when SSH_CONNECTION is set. require = "dir" exports
    the variable only if it names an existing directory; it stays a shell
    variable otherwise, so later values that reference it still expand.
    Parameter expansion and builtins only, and nothing on stdout: this runs
    for every zsh.

    Usage: includeTemplate "environment/zsh" .
*/ -}}

{{- $env := includeTemplate "environment/resolve" . | fromJson -}}
{{- range $env.variables }}
{{ with .comment }}
{{ range splitList "\n" . -}}
# {{ . }}
{{ end -}}
{{ end -}}
{{ if eq (toString .inherit) "true" -}}
: "${{ "{" }}{{ .name }}:={{ .value }}}"
{{- else if eq (toString .inherit) "ssh" -}}
if [[ -z "${SSH_CONNECTION:-}" || -z "${{ "{" }}{{ .name }}:-}" ]]; then
    {{ .name }}="{{ .value }}"
fi
{{- else -}}
{{ .name }}="{{ .value }}"
{{- end }}
{{ if eq .require "dir" -}}
if [[ -d "${{ "{" }}{{ .name }}}" ]]; then
    export {{ .name }}
fi
{{- else -}}
export {{ .name }}
{{- end }}
{{- end }}

# -U keeps path free of duplicates. This runs for every zsh, and PATH is
# inherited, so without it each nested shell (a terminal inside Neovim, a
# script with a zsh shebang, a subshell of a subshell) prepended these entries
# again. -g because .zshenv sources this file from inside a function, where a
# bare typeset would declare a local path and discard it on return.
typeset -gU path
path=(
{{- range $env.path }}
    "{{ . }}"
{{- end }}
    $path
)
