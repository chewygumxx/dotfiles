# Explicitly Always Ignore
# ------------------------

/@_sysroot_etc/src/wireguard/*  # (Secret) VPN Private Keys
/kdeconnect/                    # (Secret) Keys, clipboard, remote commands
/gh/hosts.yml                   # (Secret) Authetication Tokens

# (Secret) Cloudflare tokens
/cloudflare-ddns/*token*
/cloudflare-ddns/**/*token*
/cloudflare-ddns/cgxx_dev/dnsedit_token/
