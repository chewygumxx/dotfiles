#!/bin/false
# vim: expandtab:shiftwidth=4

# 
# 
# ~/.config/zsh/func/als
# 
# 

#
# Alias organisation wrapper
#

local __this_file="${(%):-%N}"
local +h functions

# Global asssociative arrays `alias_groups` and `alias_group_lookup` declared elsewhere
local opt name group __builtin_alias_code

function print_group () {
    if ! [[ -v alias_groups[$1] ]]; then
        print -u2 "${__this_file}: Alias group not found: $1"
        return 1
    fi
    
    local -a names=( ${(s: :)alias_groups[$1]} )
    print "[$1]"
    for name in "${names[@]}"; do
        print -n "    "
        \builtin alias "$name"
        __builtin_alias_code=$?
        if (( __builtin_alias_code )); then
            print -u2 "${__this_file}: Error printing alias '$name' of  group '$1'"
            return $?
        fi
    done
}

function print_alias () {
    if [[ -v alias_group_lookup[$1] ]]; then
        print "[${alias_group_lookup[$1]}]"
        print -n "    "
    fi

    \builtin alias ${opt:+"$opt"} "$1"
    __builtin_alias_code=$?
    if (( __builtin_alias_code )); then
        print -u2 "${__this_file}: Error printing alias '$1'"
        return $?
    fi
}

function assign_group () {
    # If group has not been specified, group by call
    local call="${${(s: :)${1#*=}}[1]}" # First word of alias value

    # Re-Assignment Check
    if [[ -v alias_group_lookup[$name] ]]; then
        local group_orig="$alias_group_lookup[$name]"

        # If same group
        if [[ "$group_orig" == "${group:-${call}}" ]]; then
            # Idempotency guard
            # Do not re-add alias name to group
            # Do not update group lookup
            return
        fi

        # From old group, clean stale registry
        local -a old_group=( ${(s: :)alias_groups[$group_orig]} )
        old_group=( ${old_group:#${name}} )

        # If old group now empty, deallocate
        if (( $#old_group )); then
            alias_groups[$group_orig]="${(j: :)old_group} "
        else
            unset "alias_groups[$group_orig]"
        fi
    fi
    alias_groups[${group:-${call}}]+="$name "
    alias_group_lookup[$name]="${group:-${call}}"
}

function register_alias () {
    name="${1%%=*}"
    if [[ "$name" =~ "[[:space:]]" ]]; then
        print -u2 "${__this_file}: Alias name cannot contain [[:space:]]: '$name'"
        return 1
    fi

    assign_group "$1"
    
    \builtin alias ${opt:+"$opt"} "$1"
    __builtin_alias_code=$?
    if (( __builtin_alias_code )); then
        print -u2 "${__this_file}: Error assigning alias '$name'"
        return $?
    fi
}

function validate_group_name () {
    if [[ "$1" =~ "[[:space:]]" ]]; then
        print -u2 "${__this_file}: Alias group cannot contain [[:space:]]: '$1'"
        return 1
    fi
}

if (( $# == 0 )); then
    for group in "${(@k)alias_groups}"; do
        print_group "$group"
    done
fi

while (( $# )); do
    case "$1" in
        -G|--group)
            validate_group_name "$2" || return $?
            group="$2"
            shift
            if ! [[ -v 2 ]]; then
                print_group "$group" || return $?
            fi
            ;;
        -G=*|--group=*)
            validate_group_name "${1#*=}" || return $?
            group="${1#*=}"
            if ! [[ -v 2 ]]; then
                print_group "$group" || return $?
            fi
            ;;
        -*)
            opt="$1"
            if ! [[ -v 2 ]]; then
                \builtin alias "$opt"
                __builtin_alias_code=$?
                if (( __builtin_alias_code )); then
                    print -u2 "${__this_file}: Error printing alias definitions of option '$opt'"
                    return $?
                fi
            fi
            ;;
        *=*) 
            register_alias "$1" || return $?
            ;;
        *)
            print_alias "$1" || return $?
            ;;
    esac
    shift
done
