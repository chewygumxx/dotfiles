#!/bin/false
# vim: expandtab:shiftwidth=4:ft=zsh

# 
# 
# ~/.config/zsh/func/alias-def
# 
# 

setopt extended_glob

local +h functions
local __this_file="${(%):-%N}"

function print_help () {
    print -f "%s\n" \
        "Safety wrapper for alias, will throw an error if unresolvable" \
        "Usage: $__this_file [opts] name=alias [name=alias] ..."

    print -f "\n%s\n" "Options:"
    print -f "    %12s %s\n" \
        "-g|--global " "Define as a global alias" \
        "-h|--help "   "Print this help"
}


while true; do
    case $1 in
        -g|--global) local global=1; shift 1  ;;
        -h|--help)   print_help;     return 0 ;;
        *) break ;;
    esac
done

if [[ ${#} -eq 0 ]]; then
    print -u2 "${__this_file}: Nothing provided"
    return 1
fi

function trim_space () { print -r -- "${${1##[[:space:]]##}%%[[:space:]]%%}" }

while [[ -n "$1" ]]; do
    local name="$(trim_space "${1%%=*}")"
    local value="$(trim_space "${1#*=}")"

    if [[ -z "$name" ]]; then
        print -u2 "${__this_file}: Invalid alias: $1"
        return 1
    fi

    local call="${${(s: :)value}[1]}" 
    if [[ ! -v global ]] && ! whence -v $call &>/dev/null; then
    then
        print -u2 "${__this_file}: Invalid invocation of alias '$name': '$call' not found"
        return 127
    fi

    builtin alias ${global:+'-g'} $name="$value"
    shift
done
