#
# Termux sv wrapper to compensate for lacklustre CLI 
#

local __this_file="${(D)${${(%):-%N}:A}}"
local +h functions 

if [[ -z "$TERMUX_VERSION" ]]; then
    print -u2 "${__this__file}: This is termux exclusive"
    return 1
fi

if [[ -z "$commands[sv]" ]]; then
    print -u2 "${__this_file}: command 'sv' not found"
    print -z "command pkg install termux-services"
    return 127
fi

