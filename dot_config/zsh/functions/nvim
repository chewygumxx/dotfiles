#!/bin/false
# vim: expandtab:shiftwidth=4

# 
# 
# ~/.config/zsh/functions/nvim
# 
# 

if (( ! $+commands[nvim] )); then
    print -u2 "${0}: Command not found: nvim"
    return 127
fi

zmodload -F zsh/stat b:zstat 2>/dev/null

local target="$1"

if (( $# != 1 )) || [[ ! -e "$target" ]]; then
    command nvim "$@"
elif [[ -d "$target" ]]; then
    cd "$target"
elif [[ "$(zstat +uid "$target")" == 0 ]]; then
    SUDO_EDITOR=nvim sudoedit "$target"
elif [[ -n "$(chezmoi managed "$target" 2>/dev/null)" ]]; then
    chezmoi edit --watch "$target"
else
    command nvim "$@"
fi
